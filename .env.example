# Copy to .env.local for local development. The NEXT_PUBLIC_ values are read
# at build time (static export). Never commit real values.

# --- Sanity (project 5prlo93h / production are the defaults in sanity/env.ts)
# NEXT_PUBLIC_SANITY_PROJECT_ID=5prlo93h
# NEXT_PUBLIC_SANITY_DATASET=production
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens).
SANITY_WRITE_TOKEN=

# --- Site
NEXT_PUBLIC_SITE_URL=https://prowildliferemoval.net
# Fields that still say [PLACEHOLDER: ...] are hidden. "true" shows them, for review only.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# --- GoHighLevel
# The form's webhook is NOT set here: it lives in api/lead-config.php on SiteGround,
# written by the deploy workflow from the GHL_WEBHOOK_URL GitHub secret.
# Website chat widget ID (Sites > Chat Widget > Get code: data-widget-id). Empty = chat hidden.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# --- Analytics (optional; nothing loads when empty). The old site used GTM-K458279.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
